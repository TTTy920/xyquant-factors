# Preserve the exact bytes covered by release and third-party checksums.
client/** -text
scripts/** -text
.github/workflows/** -text
plugins/xyquant-factors/release.json -text
plugins/xyquant-factors/bin/*.sha256 -text
requirements-build.lock -text
docs/licenses/** -text
plugins/xyquant-factors/docs/licenses/** -text
plugins/*/skills/**/*.md text eol=lf
plugins/*/skills/**/*.py text eol=lf
plugins/*/skills/**/*.yaml text eol=lf
*.exe binary
# Unified-diff context lines for empty lines contain a single required space.
scripts/macos/*.patch whitespace=-blank-at-eol
