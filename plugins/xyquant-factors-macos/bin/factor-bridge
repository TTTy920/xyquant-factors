#!/bin/sh
# The plugin host starts this with /bin/sh. Keep stdout free for MCP.
set -eu
umask 077
PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH
die() { echo "XYQuant: $*" >&2; exit 1; }
[ "$(uname -s)" = Darwin ] || die '请在 Mac 上使用这个插件。'
arch=$(uname -m)
case "$arch" in arm64|x86_64) ;; *) die "不支持的架构: $arch";; esac
# If the host itself was started under Rosetta, prefer the physical Apple chip.
if [ "$arch" = x86_64 ] && [ "$(sysctl -in sysctl.proc_translated 2>/dev/null || :)" = 1 ]; then arch=arm64; fi
plugin=$(CDPATH= cd -P "$(dirname "$0")/.." && pwd -P)
assets="$plugin/runtime"
manifest="$assets/$arch.sha256"
[ -f "$manifest" ] || die '插件文件不完整，请重新安装。'
key=$(shasum -a 256 < "$manifest")
key=${key%% *}
parent="$HOME/Library/Application Support/XYQuant/FactorConnect/runtime"
dest="$parent/$arch-$key"
mkdir -p "$parent"
[ ! -L "$parent" ] && [ ! -L "$dest" ] || die '运行目录不能是符号链接。'
if [ ! -f "$dest/.ready" ]; then
    (cd "$assets" && shasum -a 256 -c "$arch.sha256" >/dev/null) || die '插件文件校验失败，请重新安装。'
    scratch=$(mktemp -d "$parent/.unpack.XXXXXXXX")
    trap 'rm -rf "$scratch"' EXIT
    trap 'exit 1' HUP INT TERM
    mkdir "$scratch/runtime"
    tar -xzf "$assets/python-$arch.tgz" -C "$scratch/runtime"
    tar -xzf "$assets/packages-$arch.tgz" -C "$scratch/runtime/python"
    cp "$assets/bridge.pyz" "$scratch/runtime/bridge.pyz"
    : > "$scratch/runtime/.ready"
    # Atomic across two new clients: a ready directory is never overwritten.
    "$scratch/runtime/python/bin/python3.12" -I -B -c '
import errno, os, sys
src, dst = sys.argv[1:]
try:
    os.rename(src, dst)
except OSError as error:
    if error.errno not in (errno.EEXIST, errno.ENOTEMPTY) or os.path.islink(dst) or not os.path.isfile(os.path.join(dst, ".ready")):
        raise
' "$scratch/runtime" "$dest"
    rm -rf "$scratch"
    trap - EXIT HUP INT TERM
fi
py="$dest/python/bin/python3.12"
[ -x "$py" ] && [ -f "$dest/bridge.pyz" ] || die '本地运行文件不完整。请移除本版本的运行缓存后重开插件。'
if [ "${1-}" = --barra ]; then
    [ "$#" -eq 2 ] || die '用法: factor-bridge --barra 本地输入.json'
    exec "$py" -I -B "$plugin/skills/barra-attribution/scripts/attribute.py" "$2"
fi
if [ "${1-}" = --selection ]; then
    [ "$#" -eq 2 ] || die '用法: factor-bridge --selection 本地输入.json'
    exec "$py" -I -B "$plugin/skills/strategy-attribution/scripts/attribute.py" "$2"
fi
exec "$py" -I -B "$dest/bridge.pyz" "$@"
