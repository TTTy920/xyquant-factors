{
  "mcpServers": {
    "xyquant_factors": {
      "command": "/bin/sh",
      "args": [
        "./bin/factor-bridge",
        "--stdio"
      ],
      "cwd": ".",
      "env_vars": [
        "HOME",
        "TMPDIR",
        "CODEX_HOME",
        "LANG",
        "LC_CTYPE"
      ],
      "startup_timeout_sec": 120,
      "tool_timeout_sec": 60
    }
  }
}
